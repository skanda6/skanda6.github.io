    <script>
        // Placeholder definitions for original background script components
        function shaData() { console.log("shaData executed"); }
        function fetchPootuData() { console.log("fetchPootuData executed"); }

        // Initialize event observers across all existing checkboxes
        function initMenuListeners() {
            const checkboxes = document.querySelectorAll('.staticrypt-check');
            checkboxes.forEach(box => {
                box.addEventListener('change', function() {
                    updateSingleItem(this);
                });
            });
        }

        // Asynchronously process a singular item value patch modification
        function updateSingleItem(checkbox) {
            const statusSpan = checkbox.parentElement.querySelector('.status-message');
            if(statusSpan) statusSpan.textContent = " Saving...";

            const payload = {
                itemValue: checkbox.value,
                isActive: checkbox.checked
            };

            // Replace 'update_item.php' or 'update_endpoint' with your actual server destination route URL
            fetch('update_item.php', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
